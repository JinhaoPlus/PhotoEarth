{
  "sourceLanguage" : "en",
  "strings" : {
    "NSPhotoLibraryUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show cover photos from your recently visited cities on the Apple TV Home Screen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeige Titelbilder aus kürzlich besuchten Städten auf dem Apple TV-Home-Bildschirm an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra fotos de portada de las ciudades visitadas recientemente en la pantalla de inicio del Apple TV."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affichez les photos de couverture des villes visitées récemment sur l’écran d’accueil de l’Apple TV."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra le foto di copertina delle città visitate di recente sulla schermata Home di Apple TV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近訪れた都市のカバー写真をApple TVのホーム画面に表示します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Apple TV 主屏幕上显示最近到访城市的封面照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Apple TV 主畫面上顯示最近到訪城市的封面照片。"
          }
        }
      }
    },
    "CFBundleDisplayName" : {
      "comment" : "Fixed product name",
      "shouldTranslate" : false
    }
  },
  "version" : "1.0"
