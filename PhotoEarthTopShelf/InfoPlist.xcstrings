{
  "sourceLanguage" : "en",
  "strings" : {
    "NSPhotoLibraryUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show cover photos from your recently visited cities on the Apple TV Home Screen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PHOTO EARTH zeigt auf dem Home-Bildschirm deines Apple TV Titelbilder aus deinen zuletzt besuchten Städten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PHOTO EARTH muestra en la pantalla de inicio del Apple TV las fotos de portada de las ciudades que has visitado recientemente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PHOTO EARTH affiche sur l’écran d’accueil de l’Apple TV des photos de votre photothèque qui illustrent vos dernières visites."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PHOTO EARTH mostra sulla schermata Home di Apple TV le foto di copertina delle città che hai visitato di recente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近訪れた都市のカバー写真をApple TVのホーム画面に表示します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Apple TV 主屏幕上显示最近到访城市的封面照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Apple TV 主畫面上顯示最近到訪城市的封面照片。"
          }
        }
      }
    },
    "CFBundleDisplayName" : {
      "comment" : "Fixed product name",
      "shouldTranslate" : false
    }
  },
  "version" : "1.0"
}
