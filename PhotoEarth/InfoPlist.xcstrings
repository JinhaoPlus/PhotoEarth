{
  "sourceLanguage" : "en",
  "strings" : {
    "CFBundleName" : {
      "comment" : "Internal bundle name. The Home Screen uses CFBundleDisplayName.",
      "shouldTranslate" : false
    },
    "NSAppleMusicUsageDescription" : {
      "comment" : "Privacy - Media Library Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle Musik aus Apple Music für deine Diashow aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose music from Apple Music to play during your slideshow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige música de Apple Music para tu presentación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez de la musique sur Apple Music pour accompagner votre diaporama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli musica da Apple Music per la tua presentazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple MusicからスライドショーのBGMを選べます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从 Apple Music 选取音乐，为放映配乐。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從 Apple Music 選取音樂，為放映配樂。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Earth verwendet den ungefähren Standort des Apple TV, um den Globus in deiner Nähe zu öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Earth uses the Apple TV's approximate location to start the globe near you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Earth usa la ubicación aproximada del Apple TV para iniciar el globo cerca de ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Earth utilise la position approximative de l’Apple TV pour ouvrir le globe près de vous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Earth usa la posizione approssimativa di Apple TV per aprire il globo vicino a te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo EarthはApple TVのおおよその位置情報を使用して、現在地付近から地球を表示します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Earth 使用 Apple TV 的大致位置，让地球从你所在的区域开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Earth 使用 Apple TV 的大致位置，讓地球從你所在的區域開始。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Earth uses capture dates, locations, and camera information to build your travel globe on this Apple TV."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Earth 使用拍摄日期、地点和相机信息，在这台 Apple TV 上生成你的旅行地球。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Earth 使用拍攝日期、地點和相機資訊，在這部 Apple TV 上將你的旅程呈現在地球儀上。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Earth は、撮影日、撮影場所、カメラ情報を使って、この Apple TV 上で旅の記録を地球儀にまとめます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Earth erstellt deinen Reiseglobus auf diesem Apple TV anhand von Aufnahmedatum, Standort und Kameradaten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Earth crée le globe de vos voyages sur cette Apple TV à partir des dates et lieux de prise de vue et des données de l’appareil photo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Earth usa las fechas de captura, las ubicaciones y los datos de la cámara para crear tu globo de viajes en este Apple TV."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Earth usa le date di scatto, le posizioni e i dati della fotocamera per creare il globo dei tuoi viaggi su questa Apple TV."
          }
        }
      }
    },
    "CFBundleDisplayName" : {
      "comment" : "Fixed product name",
      "shouldTranslate" : false
    }
  },
  "version" : "1.0"
}
