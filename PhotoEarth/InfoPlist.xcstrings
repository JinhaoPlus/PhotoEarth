{
  "sourceLanguage" : "en",
  "strings" : {
    "CFBundleName" : {
      "comment" : "Internal bundle name. The Home Screen uses CFBundleDisplayName.",
      "shouldTranslate" : false
    },
    "NSAppleMusicUsageDescription" : {
      "comment" : "Privacy - Media Library Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Zugriff auf Apple Music kannst du Musik für deine Diashow auswählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose music from Apple Music to play during your slideshow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige música de Apple Music para tu presentación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez de la musique sur Apple Music pour accompagner votre diaporama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli musica da Apple Music per la tua presentazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple MusicからスライドショーのBGMを選べます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从 Apple Music 选取音乐，为放映配乐。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從 Apple Music 選取音樂，為放映配樂。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PHOTO EARTH nutzt den ungefähren Standort deines Apple TV, um beim Öffnen des Globus deine Umgebung zu zeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PHOTO EARTH uses the approximate location of this Apple TV to show your area when the globe opens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PHOTO EARTH usa la ubicación aproximada del Apple TV para mostrar tu zona al abrir el globo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PHOTO EARTH utilise la position approximative de l’Apple TV pour centrer le globe sur votre région au démarrage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PHOTO EARTH usa la posizione approssimativa di Apple TV per mostrare la tua zona quando apri il globo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PHOTO EARTHはApple TVのおおよその位置情報を使って、地球儀を開くときに現在地の周辺を表示します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PHOTO EARTH 使用这台 Apple TV 的大致位置，在打开地球时显示你所在的区域。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PHOTO EARTH 會使用這部 Apple TV 的大致位置，在地球上顯示你所在的區域。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PHOTO EARTH uses capture dates, locations, and camera information to build your travel globe on this Apple TV."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PHOTO EARTH 使用拍摄日期、地点和相机信息，在这台 Apple TV 上生成你的旅行地球。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PHOTO EARTH 使用拍攝日期、地點和相機資訊，在這部 Apple TV 上將你的旅程呈現在地球儀上。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PHOTO EARTH は、撮影日、撮影場所、カメラ情報を使って、この Apple TV 上で旅の記録を地球儀にまとめます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PHOTO EARTH erstellt deinen Reiseglobus auf diesem Apple TV anhand von Aufnahmedatum, Standort und Kameradaten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PHOTO EARTH crée le globe de vos voyages sur cette Apple TV à partir des dates et lieux de prise de vue et des données de l’appareil photo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PHOTO EARTH usa las fechas y los lugares de captura y los datos de la cámara para situar tus viajes en el globo. El análisis se realiza en este Apple TV."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PHOTO EARTH usa le date di scatto, le posizioni e i dati della fotocamera per creare il globo dei tuoi viaggi su questa Apple TV."
          }
        }
      }
    },
    "CFBundleDisplayName" : {
      "comment" : "Fixed product name",
      "shouldTranslate" : false
    }
  },
  "version" : "1.0"
}
