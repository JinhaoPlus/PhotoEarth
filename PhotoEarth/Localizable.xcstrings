    },
    "settings.analytics.inactive": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本不会发送使用统计。你的选择将保存在这台 Apple TV 上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本不會傳送使用統計。你的選擇會儲存在這台 Apple TV 上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build does not send analytics. Your preference is saved on this Apple TV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version sendet keine Nutzungsdaten. Deine Einstellung wird auf diesem Apple TV gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión no envía estadísticas. Tu preferencia se guarda en este Apple TV."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version n’envoie pas de statistiques. Votre choix est enregistré sur cette Apple TV."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa versione non invia statistiche. La preferenza viene salvata su questa Apple TV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンは使用状況を送信しません。設定はこの Apple TV に保存されます。"
          }
        }
      }
    },
    "settings.music.automatic": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放映时自动配乐"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放映時自動配樂"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically Play Music"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Musik automatisch abspielen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproducir música automáticamente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Musique automatique des diaporamas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduci musica automaticamente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スライドショーでBGMを自動再生"
          }
        }
      }
    },
    "settings.music.automatic_help": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，开始放映时会自动播放推荐的在线配乐。你也可以在放映时自行选曲。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，開始放映時會自動播放推薦的線上配樂。你也可以在放映時自行選曲。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When this is on, new slideshows start with recommended online music. You can also choose your own music during the slideshow."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn diese Option aktiviert ist, starten neue Diashows mit empfohlener Online-Musik. Du kannst auch während der Diashow Musik auswählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si activas esta opción, las presentaciones empezarán con música en línea recomendada. También puedes elegir la música durante la presentación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cette option est activée, les diaporamas démarrent avec la musique en ligne recommandée. Vous pouvez aussi choisir la musique pendant le diaporama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando l’opzione è attiva, le presentazioni iniziano con la musica online consigliata. Puoi anche scegliere la musica durante la presentazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スライドショーの開始時に、おすすめのオンラインBGMを再生します。再生中に自分で曲を選ぶこともできます。"
          }
        }
      }
    },
    "settings.music.online_help": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "精选器乐录音采用 CC0 1.0 许可，联网即可播放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "精選器樂錄音採用 CC0 1.0 授權，可連線播放。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stream instrumental recordings released under CC0 1.0."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier findest du Instrumentalmusik unter CC0 1.0. Zum Abspielen brauchst du eine Internetverbindung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escucha en línea grabaciones instrumentales publicadas bajo CC0 1.0."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écoutez en ligne des enregistrements instrumentaux diffusés sous CC0 1.0."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascolta in streaming registrazioni strumentali pubblicate con licenza CC0 1.0."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CC0 1.0 で公開されたインストゥルメンタル曲をストリーミングで再生できます。"
          }
        }
      }
    },
    "settings.music.credits": {
      "extractionState": "manual",
      "localizations": {
