    "detail.playable_viewing_hint" : {
      "comment" : "Compact photo-detail Siri Remote hint. Center means the clickpad center or touch surface; up reveals More Actions.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Links/rechts: Aufnahme wechseln · Mitte: Wiedergabe/Pause · Oben: Weitere Aktionen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Left/right: Change memory · Center: Play/pause · Up: More actions"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izquierda/derecha: cambiar de recuerdo · Centro: reproducir o pausar · Arriba: más acciones"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gauche/droite : changer de souvenir · Centre : lecture/pause · Haut : plus d’actions"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinistra/destra: cambia ricordo · Centro: riproduci/pausa · Su: altre azioni"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左右で前後の項目に移動、中央で再生・一時停止、上でその他の操作を表示"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左右键切换回忆 · 中键播放或暂停 · 上键打开更多操作"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按左右鍵切換項目，按中鍵播放或暫停，按上鍵顯示更多操作"
          }
        }
      }
    },
    "detail.playback_unavailable" : {
      "comment" : "Playback recovery hint for the physical Siri Remote Play/Pause button.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiedergabe nicht verfügbar. Drücke zum erneuten Versuch die Taste „Wiedergabe/Pause“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playback unavailable · Press Play/Pause to retry"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproducción no disponible. Pulsa Reproducir/Pausa para volver a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lecture indisponible. Appuyez sur Lecture/Pause pour réessayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riproduzione non disponibile. Premi Riproduci/Pausa per riprovare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生できません。再生／一時停止ボタンを押してもう一度お試しください"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂时无法播放 · 按播放/暂停键重试"
