    "journey.minimum.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose how many photos or videos with a location a visit needs to appear in Recently Visited, on the app’s Home screen, and in Top Shelf. Enter a number from 1 to 1,000."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次到访至少有这么多带定位的照片或视频，才会显示在「最近到访」、App 首页和 Apple TV 主屏。可输入 1 至 1,000。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次造訪至少有這麼多帶有位置資訊的照片或影片，才會顯示在「最近造訪」、App 首頁和 Apple TV 主畫面。可輸入 1 至 1,000。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Besuch erscheint unter „Kürzlich besucht“, auf der Startseite der App und oben auf dem Apple TV-Home-Bildschirm, wenn er mindestens so viele Fotos oder Videos mit Standortdaten enthält. Gib eine Zahl von 1 bis 1.000 ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una visita debe incluir al menos este número de fotos o vídeos con ubicación para aparecer en «Visitados recientemente», en el inicio de la app y en la parte superior de la pantalla de inicio del Apple TV. Introduce un número del 1 al 1000."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une visite doit comporter au moins ce nombre de photos ou de vidéos géolocalisées pour apparaître dans « Visités récemment », sur l’accueil de l’app et en haut de l’écran d’accueil de l’Apple TV. Saisissez un nombre de 1 à 1 000."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una visita deve comprendere almeno questo numero di foto o video con dati di posizione per apparire in «Visitati di recente», nella schermata iniziale dell’app e in cima alla schermata Home di Apple TV. Inserisci un numero da 1 a 1.000."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「最近訪れた場所」、アプリのホーム画面、トップシェルフに表示するには、1回の訪問につき、位置情報付きの写真またはビデオが指定した数以上必要です。1〜1,000の数値を入力してください。"
          }
        }
      }
    },
