    "welcome.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Earth uses capture dates, locations, and camera information on this Apple TV to build your travel globe. You can exclude albums from the scan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Earth 会在这台 Apple TV 上使用拍摄日期、地点和相机信息，生成你的旅行地球。你可以从扫描范围中排除相册。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Earth 會在這部 Apple TV 上使用拍攝日期、地點和相機資訊，將你的旅程呈現在地球儀上。你可以從掃描範圍中排除相簿。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Earth は、撮影日、撮影場所、カメラ情報を使って、この Apple TV 上で旅の記録を地球儀にまとめます。スキャンの対象からアルバムを除外できます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Earth erstellt deinen Reiseglobus auf diesem Apple TV anhand von Aufnahmedatum, Standort und Kameradaten. Du kannst Alben vom Scan ausschließen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Earth crée le globe de vos voyages sur cette Apple TV à partir des dates et lieux de prise de vue et des données de l’appareil photo. Vous pouvez exclure des albums de l’analyse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Earth crea tu globo de viajes en este Apple TV a partir de las fechas de captura, las ubicaciones y los datos de la cámara. Puedes excluir álbumes del análisis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Earth crea il globo dei tuoi viaggi su questa Apple TV usando le date di scatto, le posizioni e i dati della fotocamera. Puoi escludere degli album dalla scansione."
          }
        }
      }
    },
