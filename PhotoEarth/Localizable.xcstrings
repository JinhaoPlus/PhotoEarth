    "scan.scope.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclude albums from your globe and slideshow. Photos in these albums stay hidden even when they also belong to another album."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选中的相册会从地球和放映中排除。同一素材出现在多个相册时，也会一并排除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選取的相簿將從地球和幻燈片中排除。同一素材出現在多個相簿時，也會一併排除。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したアルバムの写真は地球儀とスライドショーに表示されません。ほかのアルバムにもある写真は、どちらから見ても非表示になります。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgewählte Alben werden aus Globus und Diashow ausgeschlossen, auch wenn ihre Fotos in weiteren Alben vorkommen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les albums sélectionnés sont exclus du globe et du diaporama, même si leurs photos figurent dans d’autres albums."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los álbumes seleccionados se excluyen del globo y de la presentación, incluso si sus fotos también aparecen en otros álbumes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli album selezionati vengono esclusi dal globo e dalla presentazione, anche se le loro foto compaiono in altri album."
          }
        }
      }
