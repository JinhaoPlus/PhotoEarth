    "settings.privacy_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Earth reads capture dates, locations, and camera information on this Apple TV. You can exclude albums from the scan. Your original photos and videos stay unchanged."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Earth 在这台 Apple TV 上读取拍摄日期、地点和相机信息。你可以从扫描范围中排除相册。原始照片和视频保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Earth 在這部 Apple TV 上讀取拍攝日期、地點和相機資訊。你可以從掃描範圍中排除相簿。原始照片和影片會保持不變。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Earth は、この Apple TV 上で撮影日、撮影場所、カメラ情報を読み取ります。スキャンの対象からアルバムを除外できます。元の写真やビデオは変更されません。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Earth liest Aufnahmedatum, Standort und Kameradaten auf diesem Apple TV aus. Du kannst Alben vom Scan ausschließen. Deine Originalfotos und -videos bleiben unverändert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Earth lit les dates et lieux de prise de vue ainsi que les données de l’appareil photo sur cette Apple TV. Vous pouvez exclure des albums de l’analyse. Vos photos et vidéos d’origine restent intactes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Earth lee las fechas de captura, las ubicaciones y los datos de la cámara en este Apple TV. Puedes excluir álbumes del análisis. Tus fotos y vídeos originales se mantienen intactos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Earth legge le date di scatto, le posizioni e i dati della fotocamera su questa Apple TV. Puoi escludere degli album dalla scansione. Le foto e i video originali restano invariati."
          }
        }
      }
    },
