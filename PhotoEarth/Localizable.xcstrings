    "globe.zoom.hint" : {
      "comment" : "Spoken zoom-toolbar instructions for a remote without touch input. Left/right moves focus, center activates, and the physical Back button closes.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle mit links oder rechts eine Zoomfunktion. Drücke zum Bestätigen die Mitteltaste oder zum Schließen die Taste „Zurück“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press left or right to choose a zoom control. Press center to activate it, or press Back to close."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa izquierda o derecha para elegir un control de zoom. Pulsa el centro para activarlo o el botón Atrás para cerrar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez à gauche ou à droite pour choisir une commande de zoom. Appuyez au centre pour l’activer ou sur le bouton Retour pour fermer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi a sinistra o a destra per scegliere un controllo zoom. Premi al centro per attivarlo o il tasto Indietro per chiudere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左右を押してズームボタンを選び、中央を押して実行します。閉じるには戻るボタンを押します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按左右键选择缩放操作，按中键执行，或按返回按钮关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按左右鍵選擇縮放操作，按中鍵執行，或按下返回按鈕關閉。"
          }
        }
      }
