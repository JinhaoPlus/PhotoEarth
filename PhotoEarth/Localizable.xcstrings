    "settings.hints_message" : {
      "comment" : "Explains that the app briefly shows on-screen Siri Remote operating hints, not images of remote-control devices.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Öffnen des Globus erscheinen Hinweise zur Bedienung. Mit einer Touch-Fernbedienung bleibt der Hinweis zum Ziehen sichtbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show remote control hints when you open the globe. With a touch remote, the drag hint stays visible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al abrir el globo se muestran indicaciones de uso. Si el mando tiene una superficie táctil, la indicación para arrastrar permanece visible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des indications s’affichent à l’ouverture du globe. Avec une télécommande tactile, l’indication de déplacement reste visible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando apri il globo compaiono i suggerimenti per i comandi. Con un telecomando touch, il suggerimento per trascinare resta visibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地球儀を開くとリモコンの操作ヒントを表示します。タッチ操作が使える場合は、ドラッグのヒントが画面に残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开地球时显示遥控器操作提示。遥控器支持触控时，拖动提示会持续显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟地球時顯示遙控器操作提示。使用支援觸控的遙控器時，拖曳提示會持續顯示。"
          }
        }
      }
    },
