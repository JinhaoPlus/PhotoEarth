    "settings.transit_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hide brief visits with only one or two photos and likely high-speed travel photos. Favorites stay. Turn this off to show everything again; your photo library is never changed."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏短时间内只拍了一两张的到访，以及疑似高速途中拍摄的照片。收藏始终保留；关闭即可恢复显示，不会修改你的照片库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隱藏短時間內只拍了一兩張照片的造訪紀錄，以及可能在高速移動時拍攝的照片。喜好項目仍會顯示。關閉後即可全部顯示，照片圖庫中的原始項目不會改變。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blendet kurze Besuche mit nur ein oder zwei Fotos sowie Fotos aus, die vermutlich bei schneller Fahrt entstanden sind. Favoriten bleiben sichtbar. Schalte die Option aus, um alles wieder einzublenden. Deine Fotomediathek bleibt unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta las visitas breves con solo una o dos fotos y las fotos que probablemente se tomaron durante un trayecto a gran velocidad. Los favoritos siguen visibles. Desactiva esta opción para volver a verlo todo. Tu fototeca se mantiene intacta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masque les visites brèves avec seulement une ou deux photos, ainsi que les photos probablement prises lors d’un déplacement à grande vitesse. Les favoris restent visibles. Désactivez cette option pour tout réafficher. Votre photothèque reste intacte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasconde le brevi visite con una o due foto e le foto probabilmente scattate durante spostamenti ad alta velocità. I preferiti restano visibili. Disattiva l’opzione per mostrare di nuovo tutto. La libreria resta invariata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短時間の訪問で写真が1〜2枚しかないものや、高速移動中に撮影したと思われる写真を非表示にします。お気に入りは表示したままです。オフにするとすべて再表示されます。写真ライブラリは変更されません。"
          }
        }
      }
    },
