    "journey.minimum.empty" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No visits meet the minimum. Lower it in Settings to see more."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前没有到访达到最低素材数。可以在设置里调低门槛。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前沒有造訪達到最低素材數。可以在設定中調低門檻。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Besuch erreicht die Mindestanzahl. Verringere sie in den Einstellungen, um mehr Besuche zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna visita alcanza el mínimo. Redúcelo en Ajustes para ver más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune visite n’atteint le minimum. Réduisez-le dans les réglages pour en voir davantage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna visita raggiunge il minimo. Abbassalo nelle impostazioni per vederne altre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最小項目数を満たす訪問がありません。設定で数を減らすと、さらに表示できます。"
          }
        }
      }
    },
