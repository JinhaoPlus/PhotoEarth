    "settings.home_screen_help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place Photo Earth in the top row, then highlight its icon to see cities with cover photos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 Photo Earth 放在主屏幕第一排，再选中它的图标，就能看到带封面照片的城市。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將 Photo Earth 放在主畫面最上排，再反白顯示 App 圖像，即可看到附有封面照片的城市。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platziere Photo Earth in der obersten Reihe und markiere das Symbol, um Städte mit Titelbildern zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca Photo Earth en la primera fila y resalta su icono para ver las ciudades con foto de portada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placez Photo Earth dans la première rangée, puis mettez son icône en surbrillance pour voir les villes avec une photo de couverture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti Photo Earth nella prima fila ed evidenzia la sua icona per vedere le città con una foto di copertina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Earthをホーム画面の最上段に置き、アイコンにフォーカスすると、カバー写真のある都市が表示されます。"
          }
        }
      }
    },
