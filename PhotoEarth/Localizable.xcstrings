      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim ersten Öffnen des Globus kurz auf die Satellitenbilder warten. Dauert das Laden länger, öffnet sich der Globus trotzdem."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wait for satellite imagery the first time the globe opens. If loading takes too long, the globe opens anyway."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al abrir el globo por primera vez, se espera a que carguen las imágenes de satélite. Si tardan, el globo se abre de todos modos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À la première ouverture du globe, l’app attend les images satellite. Si le chargement se prolonge, le globe s’ouvre quand même."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla prima apertura, il globo attende il caricamento delle immagini satellitari. Se l’attesa si prolunga, si apre comunque."
          }
