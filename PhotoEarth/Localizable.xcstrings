    "settings.music.apple_help": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在放映的配乐菜单中选择 Apple Music 并授权后，可使用你的 Apple Music 订阅选歌。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在放映的配樂選單中選擇 Apple Music 並允許取用後，即可從訂閱曲庫選歌。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Apple Music in the slideshow music menu and allow access to select songs with your subscription."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle im Musikmenü der Diashow Apple Music und erlaube den Zugriff, um mit deinem Abo Titel auszuwählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige Apple Music en el menú de música de la presentación y permite el acceso para seleccionar canciones con tu suscripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez Apple Music dans le menu musical du diaporama et autorisez l’accès pour sélectionner des morceaux avec votre abonnement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli Apple Music nel menu musicale della presentazione e consenti l’accesso per selezionare i brani con il tuo abbonamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スライドショーのBGM設定でApple Musicを選び、アクセスを許可してください。Apple Musicに登録している場合は、配信中の曲を選べます。"
          }
        }
      }
    },
