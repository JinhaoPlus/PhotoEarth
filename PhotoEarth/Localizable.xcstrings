    "journey.minimum.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A visit appears in Recently Visited when it has at least this many photos and videos with a location. Its city can then appear on Home and on the Apple TV Home Screen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有带拍摄地点的照片和视频合计达到这个数量，到访记录才会出现在「最近到访」。首页和 Apple TV 主屏幕也按这个条件推荐城市。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次到訪中，有拍攝地點的照片和影片合計達到這個數量，才會出現在「最近到訪」。首頁與 Apple TV 主畫面也依這個條件顯示城市。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Besuche mit mindestens so vielen Fotos und Videos mit Standort erscheinen unter „Kürzlich besucht“. Ihre Städte können auch auf der Startseite der App und auf dem Home-Bildschirm des Apple TV erscheinen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo las visitas con este mínimo de fotos y vídeos con ubicación aparecen en «Visitas recientes». Sus ciudades también pueden aparecer en Inicio y en la pantalla de inicio del Apple TV."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une visite doit compter au moins ce nombre de photos et de vidéos géolocalisées pour figurer dans « Visites récentes ». Sa ville peut alors apparaître à l’accueil de l’app et sur l’écran d’accueil de l’Apple TV."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In «Visite recenti» compaiono solo le visite con almeno questo numero di foto e video con dati sulla posizione. La stessa soglia si applica alle città mostrate nella Home dell’app e nella schermata Home di Apple TV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報付きの写真とビデオの合計が指定した件数に達すると、その訪問が「最近訪れた場所」に表示されます。アプリのホームとApple TVのホーム画面に表示する都市にも同じ条件が適用されます。"
          }
        }
      }
    },
