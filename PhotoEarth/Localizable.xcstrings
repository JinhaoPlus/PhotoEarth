    "settings.rebuild_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Medieninformationen werden erneut geprüft. Gültige Ortsnamen bleiben erhalten. Deine gespeicherten Erinnerungen sind während der Aktualisierung verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recheck all media information while keeping valid place names. Saved memories remain available during the update."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a comprobar toda la información del contenido sin perder los nombres de lugares válidos. Los recuerdos guardados siguen disponibles durante la actualización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revérifiez toutes les informations des médias en conservant les noms de lieux valides. Les souvenirs enregistrés restent disponibles pendant la mise à jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricontrolla tutte le informazioni dei contenuti mantenendo i nomi dei luoghi validi. I ricordi salvati restano disponibili durante l’aggiornamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効な地名を維持しながら、すべてのメディア情報を再確認します。保存された思い出は更新中も利用できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新检查所有照片和视频的信息，同时保留已有的地点名称。更新期间仍可正常浏览已有内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新檢查所有照片和影片的資訊，同時保留現有的地點名稱。更新期間仍可正常瀏覽現有內容。"
          }
