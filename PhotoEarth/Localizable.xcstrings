    "slideshow.remote_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke links oder rechts, um zur vorherigen oder nächsten Aufnahme zu wechseln. Drücke oben, um die Steuerung einzublenden. Mit der Taste „Wiedergabe/Pause“ hältst du die Diashow an oder setzt sie fort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press left or right to skip, up for controls, or Play/Pause to pause or resume."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa izquierda o derecha para cambiar, arriba para ver los controles y Reproducir/Pausa para pausar o continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez à gauche ou à droite pour changer de souvenir, en haut pour afficher les commandes et sur Lecture/Pause pour mettre le diaporama en pause ou le reprendre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi a sinistra o a destra per passare da un ricordo all’altro, in alto per mostrare i controlli e Riproduci/Pausa per mettere in pausa o riprendere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左右で切り替え、上で操作ボタンを表示します。再生／一時停止ボタンで一時停止・再開できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左右键切换，上键显示控件，播放/暂停键暂停或继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左右鍵切換，上鍵顯示控制項目，播放/暫停鍵可暫停或繼續。"
          }
        }
      }
    },
