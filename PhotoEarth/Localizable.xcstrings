        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初に地球儀を開くときは衛星画像の読み込みを待ちます。時間がかかる場合は、読み込みの完了を待たずに地球儀を表示します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
