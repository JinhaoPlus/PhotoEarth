    "slideshow.remote_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke links oder rechts, um die Erinnerung zu wechseln, und oben, um die Steuerung einzublenden. Mit der Wiedergabe-/Pausetaste hältst du die Diashow an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Left or right changes memory. Up shows controls. Play/Pause pauses the slideshow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa a la izquierda o a la derecha para cambiar de recuerdo, y arriba para ver los controles. Reproducir/Pausa pone la presentación en pausa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez à gauche ou à droite pour changer de souvenir, et en haut pour afficher les commandes. Lecture/Pause met le diaporama en pause."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi a sinistra o a destra per cambiare ricordo e in alto per mostrare i comandi. Riproduci/Pausa mette in pausa la presentazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左右で思い出を切り替え、上で操作ボタンを表示します。再生／一時停止ボタンでスライドショーを一時停止できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按左右键切换回忆，按上键显示播放控件，按播放/暂停键暂停放映。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按左右鍵切換回憶，按上鍵顯示播放控制項目，按播放/暫停鍵暫停放映。"
          }
        }
      }
    },
