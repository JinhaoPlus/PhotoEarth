    "settings.wait_for_globe_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei der ersten Anzeige bleibt der Globus hinter einem filmischen Ladebildschirm, bis MapKit die sichtbaren Satellitenkacheln fertiggestellt hat. Ein Zeitlimit verhindert endloses Warten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On first display, keep the globe behind a cinematic loading screen until MapKit finishes the visible satellite tiles. A timeout prevents an endless wait."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la primera visualización, el globo permanece tras una pantalla de carga cinematográfica hasta que MapKit completa los mosaicos de satélite visibles. Un tiempo límite evita una espera infinita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lors du premier affichage, le globe reste derrière un écran de chargement cinématographique jusqu'à ce que MapKit termine les tuiles satellite visibles. Un délai maximal évite une attente sans fin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla prima visualizzazione, il globo resta dietro una schermata di caricamento cinematografica finché MapKit non completa i riquadri satellitari visibili. Un limite di tempo evita un'attesa infinita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地球儀を初めて開くときは、衛星画像の準備ができるまで読み込み画面を表示します。時間がかかる場合は自動で先に進みます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首次显示地球时，会先停留在电影感加载画面，等卫星影像准备好后再进入；等待过久时会自动继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首次顯示地球時，會先停留在電影感載入畫面，等衛星影像準備好後再進入；等待過久時會自動繼續。"
          }
        }
      }
    },
