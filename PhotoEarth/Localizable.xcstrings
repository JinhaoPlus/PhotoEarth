    "purchase.trial_end_terms": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the trial ends, you can still browse and play one trip for free. You won’t be charged automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试用到期不会自动扣费，你仍可免费回看和放映一段旅程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "試用結束後不會自動扣款，你仍可免費瀏覽及放映一段旅程。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体験終了後も、1つの旅の写真とスライドショーを無料で楽しめます。自動で課金されることはありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der Testphase kannst du eine Reise weiterhin kostenlos ansehen und als Diashow abspielen. Es wird nichts automatisch abgebucht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la fin de l’essai, vous pourrez toujours revoir un voyage gratuitement, y compris en diaporama. Aucun prélèvement automatique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al terminar la prueba, podrás seguir viendo un viaje y su presentación gratis. No se te cobrará automáticamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al termine della prova potrai ancora rivedere gratis un viaggio, anche come presentazione. Non è previsto alcun addebito automatico."
          }
        }
      }
    },
