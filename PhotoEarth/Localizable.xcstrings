    "settings.transit_help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hide brief stops and photos taken in transit. Favorites stay visible."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏短暂停留和疑似途中拍摄的照片。收藏的照片始终显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隱藏短暫停留的造訪紀錄，以及可能在移動中拍攝的照片。喜好項目仍會顯示。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blendet kurze Zwischenstopps und unterwegs aufgenommene Fotos aus. Favoriten bleiben sichtbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta las paradas breves y las fotos tomadas de paso. Los favoritos siguen visibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masque les arrêts brefs et les photos prises en transit. Les favoris restent visibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasconde le brevi soste e le foto scattate in transito. I preferiti restano visibili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短い立ち寄りや移動中と思われる写真を非表示にします。お気に入りは常に表示します。"
          }
        }
      }
    },
