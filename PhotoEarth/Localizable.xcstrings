    "preview.expired" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your 7-day trial has ended. You can still browse one trip and play its slideshow for free. A one-time purchase permanently unlocks all trips."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "七天试用已结束。你仍可免费回看和放映一段旅程。购买完整版后，全部旅程将永久解锁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 天免費試用已結束。你仍可免費瀏覽及放映一段旅程。一次購買完整版，即可永久解鎖所有旅程。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7日間の無料体験は終了しました。引き続き、1つの旅の写真とスライドショーを無料で楽しめます。完全版を一度購入すれば、すべての旅を期限なく楽しめます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine 7-tägige Testphase ist beendet. Du kannst weiterhin eine Reise kostenlos ansehen und als Diashow abspielen. Mit einem einmaligen Kauf schaltest du alle Reisen dauerhaft frei."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre essai de 7 jours est terminé. Vous pouvez toujours revoir gratuitement un voyage, y compris en diaporama. Un achat unique débloque définitivement tous vos voyages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu prueba de 7 días ha terminado. Puedes seguir viendo un viaje y su presentación gratis. Un solo pago desbloquea todos tus viajes de forma permanente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prova di 7 giorni è terminata. Puoi ancora rivedere gratis un viaggio, anche come presentazione. Un unico acquisto sblocca tutti i viaggi in modo permanente."
          }
        }
      }
    },
    "preview.terms" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Browse all your trips and play their slideshows free for 7 days. When the trial ends, you can still browse and play one trip for free. You won’t be charged automatically. A one-time purchase permanently unlocks all trips."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免费试用 7 天，浏览和放映全部旅程。到期不会自动扣费，仍可免费回看和放映一段旅程。购买完整版后，全部旅程将永久解锁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免費試用 7 天，瀏覽及放映所有旅程。試用結束後不會自動扣款，你仍可免費瀏覽及放映一段旅程。一次購買完整版，即可永久解鎖所有旅程。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7日間、すべての旅の写真とスライドショーを無料で楽しめます。体験終了後も、1つの旅は引き続き無料です。自動で課金されることはありません。完全版を一度購入すれば、すべての旅を期限なく楽しめます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst dir 7 Tage lang alle Reisen kostenlos ansehen und als Diashow abspielen. Danach bleibt das für eine Reise kostenlos. Es wird nichts automatisch abgebucht. Mit einem einmaligen Kauf schaltest du alle Reisen dauerhaft frei."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant 7 jours, tous vos voyages sont accessibles gratuitement, y compris en diaporama. À la fin de l’essai, un voyage reste accessible dans les mêmes conditions. Aucun prélèvement automatique. Un achat unique débloque définitivement tous vos voyages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante 7 días puedes ver todos tus viajes y reproducir sus presentaciones gratis. Cuando termine la prueba, podrás seguir viendo un viaje y su presentación gratis. No se te cobrará automáticamente. Un solo pago desbloquea todos tus viajes de forma permanente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per 7 giorni puoi esplorare gratis tutti i viaggi e rivederli come presentazioni. Al termine della prova puoi ancora rivedere gratis un viaggio, anche come presentazione. Non è previsto alcun addebito automatico. Con un unico acquisto sblocchi tutti i viaggi per sempre."
          }
        }
      }
    },
