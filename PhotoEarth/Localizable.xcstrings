    "home.explore_hint" : {
      "comment" : "Spoken hint for entering direct globe control. Use Apple's localized terms for clickpad center and touch surface, not a literal translation of Select.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drehe den Globus mit der Fernbedienung. Drücke die Klickpad-Mitte oder die Touch-Oberfläche, um die Fotos in diesem Kartenausschnitt anzusehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn the globe with the remote, then press the clickpad center or touch surface to browse visible photos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira el globo con el mando y pulsa el centro del clickpad o la superficie táctil para ver las fotos de esa zona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites tourner le globe avec la télécommande, puis appuyez sur le centre du clickpad ou sur la surface tactile pour parcourir les photos de la zone affichée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruota il globo con il telecomando, poi premi il centro del clickpad o la superficie touch per sfogliare le foto della zona inquadrata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リモコンで地球儀を回し、クリックパッドの中央またはタッチサーフェスを押すと、表示範囲の写真を見ることができます。"
