    "settings.analytics.purpose" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usage statistics are used only to help the developers improve the app. They never include your photos, videos, or the locations where they were taken."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用统计仅用于帮助开发者改进 App。不会上传你的照片、视频或拍摄地点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用統計僅用於協助開發者改善 App。不會上傳你的照片、影片或拍攝地點。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzungsstatistiken helfen dem Entwicklungsteam ausschließlich dabei, die App zu verbessern. Deine Fotos, Videos und Aufnahmeorte werden dabei nicht übertragen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las estadísticas de uso solo sirven para ayudar al equipo de desarrollo a mejorar la app. No se envían tus fotos, vídeos ni los lugares donde se tomaron."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les statistiques d’utilisation servent uniquement à aider les développeurs à améliorer l’app. Vos photos, vidéos et lieux de prise de vue ne sont pas transmis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le statistiche di utilizzo servono solo ad aiutare gli sviluppatori a migliorare l’app. Le tue foto, i tuoi video e i luoghi in cui sono stati ripresi non vengono inviati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "利用統計は、開発者がアプリを改善する目的でのみ使用します。写真、ビデオ、撮影場所を送信することはありません。"
          }
        }
      }
    },
    "settings.usage_analytics_help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share an installation ID and actions such as opening a photo wall or starting a slideshow with PostHog."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向 PostHog 发送安装标识，以及打开照片墙、开始放映等操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向 PostHog 傳送安裝識別碼，以及開啟照片牆、開始放映等操作。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendet eine Installations-ID und Aktionen wie das Öffnen einer Fotowand oder den Start einer Diashow an PostHog."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se envían a PostHog un identificador de instalación y datos sobre acciones como abrir el muro de fotos o iniciar una presentación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transmet à PostHog un identifiant d’installation et des actions comme l’ouverture d’un mur de photos ou le lancement d’un diaporama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia a PostHog un identificativo dell’installazione e informazioni su azioni come l’apertura di una galleria o l’avvio di una presentazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストール ID と、フォトウォールを開く、スライドショーを始めるなどの操作を PostHog に送信します。"
          }
        }
      }
