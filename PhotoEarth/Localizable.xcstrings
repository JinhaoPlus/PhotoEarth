    "scan.scope.camera_help": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时读不到相机信息的照片和视频仍会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時無法讀取相機資訊的照片和影片仍會保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos and videos are kept if their camera information can’t be read yet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos und Videos bleiben enthalten, wenn sich ihre Kameradaten noch nicht lesen lassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se incluyen las fotos y los vídeos si aún no se puede leer la información de la cámara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos et vidéos restent incluses si les informations de l’appareil photo ne sont pas encore lisibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se i dati della fotocamera non sono ancora leggibili, le foto e i video restano inclusi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラ情報をまだ読み取れない写真やビデオはスキャンに含まれます。"
          }
        }
      }
    },
    "settings.unlock_help": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买后可永久浏览和放映全部旅程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "購買後即可永久瀏覽及放映所有旅程。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A one-time purchase permanently unlocks all your trips and their slideshows."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte alle Reisen dauerhaft frei, um sie anzusehen und als Diashow abzuspielen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con la versión completa, podrás volver a ver todos tus viajes y reproducir sus presentaciones siempre que quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version complète vous permet de revoir tous vos voyages, y compris en diaporama, sans limite de durée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca definitivamente tutti i tuoi viaggi per sfogliarli o rivederli in una presentazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入すると、すべての旅をいつでも閲覧したり、スライドショーで再生したりできます。"
          }
        }
      }
    },
