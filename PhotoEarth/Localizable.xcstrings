    "settings.privacy_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capture times, locations, and camera information help organize your trips on this Apple TV. Your original photos and videos stay unchanged."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据拍摄时间、位置和相机信息，在这台 Apple TV 上整理旅程。原始照片和视频保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "掃描會讀取拍攝時間、地點和相機資訊，在這部 Apple TV 上整理旅程。原始照片和影片不會改動。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "撮影日時、位置情報、カメラ情報を使って、この Apple TV 上で旅を整理します。元の写真やビデオは変更されません。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufnahmezeit, Standort und Kameradaten helfen, Reisen auf diesem Apple TV zu ordnen. Die Originalfotos und -videos bleiben unverändert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les voyages sont organisés sur cette Apple TV à partir des dates, des lieux de prise de vue et des informations de l’appareil photo. Les photos et vidéos originales restent intactes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La hora, la ubicación y los datos de la cámara se usan para organizar los viajes en este Apple TV. Las fotos y los vídeos originales se conservan intactos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I viaggi vengono organizzati su questa Apple TV usando data, ora, posizione e dati della fotocamera. Le foto e i video originali restano invariati."
          }
        }
      }
    },
