    "settings.transit_help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hide photos and videos whose capture times and locations suggest you were in transit. Favorites stay visible."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据拍摄时间和位置，隐藏可能在途中拍摄的照片和视频。收藏项目不受此筛选影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依拍攝時間和地點，隱藏可能在途中拍攝的照片和影片。已加入喜好項目的照片和影片仍會顯示。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anhand von Aufnahmezeit und -ort werden Fotos und Videos ausgeblendet, die vermutlich auf der Durchreise entstanden sind. Favoriten bleiben sichtbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usan la hora y la ubicación para ocultar fotos y vídeos que parecen haberse tomado de paso. Este filtro no afecta a los favoritos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’heure et le lieu de prise de vue permettent de repérer les photos et vidéos probablement prises en chemin et de les masquer. Les favoris restent visibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In base a data, ora e posizione, vengono nascosti foto e video che sembrano risalire a una sosta di passaggio. I preferiti restano visibili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
