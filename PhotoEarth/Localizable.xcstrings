    "globe.controls.touch_accessibility" : {
      "comment" : "Spoken globe instructions for Siri Remote touch input. Center opens photos; Play/Pause opens zoom controls.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streiche über das Klickpad oder die Touch-Oberfläche, um die Ansicht zu verschieben. Mit dem Klickpad-Ring drehst du die Ansicht. Drücke die Klickpad-Mitte oder die Touch-Oberfläche, um Fotos anzusehen. Mit der Taste „Wiedergabe/Pause“ öffnest du die Zoomsteuerung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe on the clickpad or touch surface to drag it, or press the clickpad ring to turn it. Press the clickpad center or touch surface to view photos. Press Play/Pause to open zoom controls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza el dedo por el clickpad o la superficie táctil para moverlo, o pulsa el anillo del clickpad para girarlo. Pulsa el centro del clickpad o la superficie táctil para ver fotos. Pulsa Reproducir/Pausa para abrir los controles de zoom."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez le clickpad ou la surface tactile pour déplacer le globe. Appuyez sur le bord du clickpad pour faire tourner le globe, ou sur le centre du clickpad ou la surface tactile pour voir les photos. Appuyez sur Lecture/Pause pour ouvrir les commandes de zoom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri sul clickpad o sulla superficie touch per spostarlo, oppure premi l’anello del clickpad per ruotarlo. Premi il centro del clickpad o la superficie touch per vedere le foto. Premi Riproduci/Pausa per aprire i controlli dello zoom."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリックパッドまたはタッチサーフェスをスワイプして地球儀を動かします。クリックパッドのリングを押すと地球儀が回ります。クリックパッドの中央またはタッチサーフェスを押すと表示範囲の写真が開きます。再生／一時停止ボタンを押すとズーム操作が表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻扫点按板或触控表面来拖动地球，也可按点按板圆环来转动。按下点按板中央或触控表面查看照片。按播放/暂停键打开缩放控制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "滑動觸控板或觸控表面來拖曳地球，也可按下觸控板環來轉動。按下觸控板中央或觸控表面來檢視照片。按播放/暫停鍵打開縮放控制。"
          }
        }
      }
    },
