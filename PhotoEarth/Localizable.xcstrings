    "settings.home_screen_help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place PHOTO EARTH in the top row and highlight its icon to preview city photos from your library. Available during your trial and with the full version."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 PHOTO EARTH 放在主屏幕第一排，用遥控器移到它的图标上，即可预览最近到访城市的照片。试用期间或购买完整版后可用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將 PHOTO EARTH 放在主畫面最上排，把焦點移到 App 圖像上，就能預覽最近到訪城市的照片。試用期間及購買完整版後都可使用。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschiebe PHOTO EARTH in die oberste Reihe des Home-Bildschirms. Markiere das App-Symbol, um Fotos aus deinen zuletzt besuchten Städten zu sehen. Diese Vorschau ist während der Testphase und mit der Vollversion verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca PHOTO EARTH en la primera fila de la pantalla de inicio. Sitúate sobre su icono para ver tus fotos de las ciudades que has visitado. Disponible durante la prueba y con la versión completa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placez PHOTO EARTH au premier rang et mettez son icône en surbrillance pour voir des photos de villes de votre photothèque. Disponible pendant l’essai et avec la version complète."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta PHOTO EARTH nella prima riga della schermata Home e soffermati sull’icona per vedere le foto delle città visitate di recente. L’anteprima è disponibile durante la prova e con la versione completa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PHOTO EARTHをホーム画面の一番上の段に置くと、アイコンに合わせたときに、訪れた都市の写真が表示されます。無料体験中と完全版で利用できます。"
          }
        }
      }
    },
