            "value": "隱私權政策（簡體中文）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy Policy"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datenschutzerklärung (Englisch)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Política de privacidad (en inglés)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Politique de confidentialité (en anglais)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Informativa sulla privacy (in inglese)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライバシーポリシー（英語）"
          }
        }
