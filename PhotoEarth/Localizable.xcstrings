    "globe.controls.touch_accessibility" : {
      "comment" : "Spoken globe instructions for Siri Remote touch input. Center opens photos; Play/Pause opens zoom controls.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkunde den Globus. Streiche auf dem Klickpad oder der Touch-Oberfläche, um ihn zu bewegen, oder drücke auf den Klickpad-Ring, um ihn zu drehen. Drücke die Klickpad-Mitte oder die Touch-Oberfläche, um Fotos anzusehen. Drücke die Wiedergabe-/Pausetaste, um die Zoomsteuerung zu öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explore the globe. Swipe on the clickpad or touch surface to drag it, or press the clickpad ring to turn it. Press the clickpad center or touch surface to view photos. Press Play/Pause to open zoom controls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explora el globo. Desliza el dedo por el clickpad o la superficie táctil para moverlo, o pulsa el anillo del clickpad para girarlo. Pulsa el centro del clickpad o la superficie táctil para ver fotos. Pulsa Reproducir/Pausa para abrir los controles de zoom."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explorez le globe. Balayez le clickpad ou la surface tactile pour le déplacer, ou appuyez sur le cercle du clickpad pour le tourner. Appuyez sur le centre du clickpad ou sur la surface tactile pour voir les photos. Appuyez sur Lecture/Pause pour ouvrir les commandes de zoom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esplora il globo. Scorri sul clickpad o sulla superficie touch per spostarlo, oppure premi l’anello del clickpad per ruotarlo. Premi il centro del clickpad o la superficie touch per vedere le foto. Premi Riproduci/Pausa per aprire i controlli dello zoom."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地球を探索します。クリックパッドまたはタッチサーフェスをスワイプして地球を動かすか、クリックパッドリングを押して回します。クリックパッドの中央またはタッチサーフェスを押すと写真が開きます。再生／一時停止ボタンを押すとズーム操作が開きます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "探索地球。轻扫点按板或触控表面来拖动地球，也可按点按板圆环来转动。按下点按板中央或触控表面查看照片。按播放/暂停键打开缩放控制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "探索地球。滑動觸控板或觸控表面來拖曳地球，也可按下觸控板環來轉動。按下觸控板中央或觸控表面來檢視照片。按播放/暫停鍵打開縮放控制。"
          }
        }
      }
    },
