    "globe.controls.accessibility" : {
      "comment" : "Spoken globe instructions for a remote without touch input. Center opens photos; Play/Pause opens zoom controls.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit den Richtungstasten drehst du die Ansicht. Drücke die Mitteltaste, um Fotos anzusehen. Mit der Taste „Wiedergabe/Pause“ öffnest du die Zoomsteuerung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the direction buttons to turn it. Press the center button to view photos. Press Play/Pause to open zoom controls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa los botones de dirección para girarlo. Pulsa el botón central para ver fotos. Pulsa Reproducir/Pausa para abrir los controles de zoom."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez les touches directionnelles pour faire tourner le globe. Appuyez sur le bouton central pour voir les photos. Appuyez sur Lecture/Pause pour ouvrir les commandes de zoom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa i tasti direzionali per ruotarlo. Premi il tasto centrale per vedere le foto. Premi Riproduci/Pausa per aprire i controlli dello zoom."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "方向ボタンで地球儀を回します。中央ボタンを押すと表示範囲の写真が開きます。再生／一時停止ボタンを押すとズームボタンが表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用方向键转动地球。按中键查看照片。按播放/暂停键打开缩放控制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用方向鍵轉動地球。按中鍵檢視照片。按播放/暫停鍵打開縮放控制。"
          }
        }
      }
    },
