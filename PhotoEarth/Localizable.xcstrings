    "globe.zoom.touch_hint" : {
      "comment" : "Spoken zoom-toolbar instructions for Siri Remote touch input. Swipe still drags the globe; left/right changes toolbar focus; clickpad center activates; Back closes.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streiche über das Klickpad oder die Touch-Oberfläche, um die Ansicht zu verschieben. Wähle mit links oder rechts eine Zoomfunktion. Drücke zum Bestätigen die Klickpad-Mitte oder die Touch-Oberfläche. Mit der Taste „Zurück“ schließt du die Zoomsteuerung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe on the clickpad or touch surface to drag the globe. Press left or right to choose a zoom control. Press the clickpad center or touch surface to activate it, or press Back to close."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza el dedo por el clickpad o la superficie táctil para mover el globo. Pulsa izquierda o derecha para elegir un control de zoom. Pulsa el centro del clickpad o la superficie táctil para activarlo, o el botón Atrás para cerrar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez le clickpad ou la surface tactile pour déplacer le globe. Appuyez à gauche ou à droite pour choisir une commande de zoom. Appuyez sur le centre du clickpad ou sur la surface tactile pour l’activer, ou sur le bouton Retour pour fermer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri sul clickpad o sulla superficie touch per spostare il globo. Premi a sinistra o a destra per scegliere un controllo zoom. Premi il centro del clickpad o la superficie touch per attivarlo, oppure il tasto Indietro per chiudere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリックパッドまたはタッチサーフェスをスワイプして地球儀を動かします。左右を押してズームボタンを選び、クリックパッドの中央またはタッチサーフェスを押して実行します。閉じるには戻るボタンを押します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻扫点按板或触控表面来拖动地球。按左右键选择缩放操作，按下点按板中央或触控表面执行，或按返回按钮关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "滑動觸控板或觸控表面來拖曳地球。按左右鍵選擇縮放操作，按下觸控板中央或觸控表面執行，或按下返回按鈕關閉。"
          }
        }
      }
    },
