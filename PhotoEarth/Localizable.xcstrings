    "globe.controls.accessibility" : {
      "comment" : "Spoken globe instructions for a remote without touch input. Center opens photos; Play/Pause opens zoom controls.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkunde den Globus. Drehe ihn mit den Richtungstasten. Drücke die Mitteltaste, um Fotos anzusehen. Drücke die Wiedergabe-/Pausetaste, um die Zoomsteuerung zu öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explore the globe. Use the direction buttons to turn it. Press the center button to view photos. Press Play/Pause to open zoom controls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explora el globo. Usa los botones de dirección para girarlo. Pulsa el botón central para ver fotos. Pulsa Reproducir/Pausa para abrir los controles de zoom."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explorez le globe. Utilisez les touches directionnelles pour le tourner. Appuyez sur le bouton central pour voir les photos. Appuyez sur Lecture/Pause pour ouvrir les commandes de zoom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esplora il globo. Usa i tasti direzionali per ruotarlo. Premi il tasto centrale per vedere le foto. Premi Riproduci/Pausa per aprire i controlli dello zoom."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地球を探索します。方向ボタンで地球を回します。中央ボタンを押すと写真が開きます。再生／一時停止ボタンを押すとズーム操作が開きます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "探索地球。使用方向键转动地球。按中键查看照片。按播放/暂停键打开缩放控制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "探索地球。使用方向鍵轉動地球。按中鍵檢視照片。按播放/暫停鍵打開縮放控制。"
          }
        }
      }
    },
